[Unit]
Description=Juicy Disk Guard
After=juicy-mount.service
PartOf=juicy-mount.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash -c ' \
    STATE_FILE="/cloud/cache/juicy_meta/.juicy_guard_state"; \
    RAW_FREE=$$(df -BG /cloud/cache/juicy_chunks_local | awk "NR==2 {print \$$4}" | sed "s/G//"); \
    \
    # 使用一般索引陣列 (按 Index 0, 1, 2... 一一對應) \
    THRESHOLDS=( 25  50 100 150 200 250 300 350 400 450 500 ); \
    QUOTAS=(     2  20  40  60  80 100 120 140 160 180 200 ); \
    WEIGHTS=( 2000 1000 900 800 700 600 500 400 300 200 100 ); \
    \
    MATCH_IDX=10; \
    for i in $${!THRESHOLDS[@]}; do \
        if [ "$${RAW_FREE}" -le "$${THRESHOLDS[$$i]}" ]; then \
            MATCH_IDX=$$i; \
            break; \
        fi; \
    done; \
    \
    MATCHED_TIER=$${THRESHOLDS[$$MATCH_IDX]}; \
    TOTAL_QUOTA=$${QUOTAS[$$MATCH_IDX]}; \
    WEIGHT=$${WEIGHTS[$$MATCH_IDX]}; \
    \
    if [ -f "$$STATE_FILE" ]; then \
        read LAST_TIER LAST_QUOTA LAST_WEIGHT < "$$STATE_FILE"; \
    else \
        LAST_TIER=-1; \
    fi; \
    \
    if [ "$$MATCHED_TIER" -ne "$$LAST_TIER" ]; then \
        systemctl set-property juicy-mount.service CPUQuota=$${TOTAL_QUOTA}%; \
        systemctl set-property juicy-upload.service CPUWeight=$${WEIGHT}; \
        echo "$$MATCHED_TIER $$TOTAL_QUOTA $$WEIGHT" > "$$STATE_FILE"; \
        echo "[Juicy Guard] Tier: <= $${MATCHED_TIER}G (Raw Free: $${RAW_FREE}G) | Multi-Core Quota: $${TOTAL_QUOTA}% | CPUWeight: $${WEIGHT}"; \
    fi'