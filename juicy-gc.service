[Unit]
Description=Juicy Garbage Collection & Cloud Cleanup
RequiresMountsFor=/cloud/chunks
Requires=juicy-chunks-union.service
After=juicy-chunks-union.service
After=juicy-mount.service

[Service]
Type=oneshot
User=root
# 1. 執行 JuiceFS 核心 GC (已改為 Redis Meta URL)
ExecStart=/usr/local/bin/juicefs gc --delete redis://127.0.0.1:6379/1

# 2. (已移除 SQLite VACUUM) 
# 替代方案：改為執行 Redis 背景記憶體重組，釋放內部記憶體碎片
ExecStartPost=/usr/bin/redis-cli MEMORY PURGE
ExecStartPost=/usr/bin/redis-cli BGREWRITEAOF

# 3. 清理超過 30 天的本地 Metadata Dump
ExecStartPost=/usr/bin/find /cloud/chunks/juicy-chunks/meta/ -name "dump-*.json.gz" -mtime +30 -delete

# 4. 清理 pCloud 上超過 24 小時的 .partial 暫存檔
ExecStartPost=/usr/bin/rclone delete pcloud_ecstasy0:/rclone/juicy_chunks \
    --include "*.partial" \
    --min-age 24h \
    --config=/home/cmm/.config/rclone/rclone.conf

# 5. 清理 pCloud Trash (2006 某日後 cleanup 無法成功執行，可能 pCloud API 更動)
#ExecStartPost=/usr/bin/rclone cleanup pcloud_ecstasy0: \
#    --config=/home/cmm/.config/rclone/rclone.conf