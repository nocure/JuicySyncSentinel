[Unit]
Description=Juicy Background Chunks Upload
After=juicy-mount.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/rclone move /cloud/cache/juicy_chunks_local pcloud_ecstasy0:/rclone/juicy_chunks \
    --config=/home/cmm/.config/rclone/rclone.conf \
    --min-age 20s \
    --transfers 5 \
    --checkers 10 \
    --use-mmap \
    --contimeout 60s \
    --timeout 600s \
    --order-by modtime,ascending \
    --delete-empty-src-dirs \
    --ignore-errors \
    --log-level NOTICE \
    --stats 5s \
    --stats-one-line \
    --stats-log-level NOTICE \
    --log-file /var/log/juicy/juicy-upload.log