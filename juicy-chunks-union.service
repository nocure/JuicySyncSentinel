[Unit]
Description=MergerFS Union for Juicy Chunks
RequiresMountsFor=/cloud/juicy_chunks_remote
Requires=juicy-chunks-remote.service
After=juicy-chunks-remote.service
PartOf=juicy-mount.service

[Service]
Type=simple
KillMode=none
ExecStartPre=/usr/bin/mkdir -p /cloud/cache/juicy_chunks_local /cloud/chunks
ExecStart=/usr/bin/mergerfs \
  -f # foreground mode \
  /cloud/cache/juicy_chunks_local=RW:/cloud/juicy_chunks_remote=RO \
  /cloud/chunks \
  -o category.create=ff \
  -o func.getattr=newest \
  -o fsname=juicy-merger
ExecStop=/bin/fusermount3 -u -z /cloud/chunks
Restart=on-failure
RestartSec=5s