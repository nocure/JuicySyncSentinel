[Unit]
Description=Juicy Metadata Backup
After=juicy-mount.service

[Service]
Type=oneshot
User=root
ExecStartPre=/usr/bin/mkdir -p /cloud/cache/juicy_meta
# Step 1: 執行 juicefs dump 匯出元資料，加上 timestamp 並 gzip 壓縮
ExecStart=/bin/bash -c '\
  META_URL="redis://127.0.0.1:6379/1"; \
  BACKUP_DIR="/cloud/cache/juicy_meta"; \
  mkdir -p "$BACKUP_DIR"; \
  \
  TIMESTAMP=$(date +%%Y-%%m%%d-%%H%%M.%%S); \
  FINAL_BAK="$BACKUP_DIR/juicefs_meta.$TIMESTAMP.json.gz"; \
  \
  /usr/local/bin/juicefs dump "$META_URL" | /usr/bin/gzip > "$FINAL_BAK"; \
'

# Step 2: 複製至雲端 pCloud 目的地
ExecStart=/usr/bin/rclone copy /cloud/cache/juicy_meta/ pcloud_ecstasy0:/rclone/direct/juicy_meta/ \
  --config=/home/cmm/.config/rclone/rclone.conf \
  --include 'juicefs_meta.*.json.gz' \
  --quiet

# Step 3: 清除本地舊備份（保留最新的 30 份）
ExecStart=/bin/bash -c 'ls -t /cloud/cache/juicy_meta/juicefs_meta.*.json.gz 2>/dev/null | tail -n +31 | xargs -r rm -f'

# Step 4: 清除雲端舊備份（保留最新的 30 份）
ExecStart=/bin/bash -c '\
  /usr/bin/rclone lsf pcloud_ecstasy0:/rclone/direct/juicy_meta/ \
    --config=/home/cmm/.config/rclone/rclone.conf \
    --include "juicefs_meta.*.json.gz" --files-only --format "p" | sort -r | tail -n +31 | \
    xargs -I {} /usr/bin/rclone deletefile pcloud_ecstasy0:/rclone/direct/juicy_meta/{} \
    --config=/home/cmm/.config/rclone/rclone.conf --quiet \
'