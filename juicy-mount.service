[Unit]
Description=JuiceFS Mount Primary Service (Juicy)
Requires=juicy-chunks.service
After=juicy-chunks.service
Wants=juicy-chunks.service juicy-disk-guard.timer juicy-upload.timer juicy-meta-backup.timer juicy-gc.timer

[Service]
Type=simple
#User=1001
#Group=1001
ExecStartPre=/usr/bin/mkdir -p /cloud/juicy
ExecStartPre=/usr/bin/sleep 1
ExecStart=/usr/local/bin/juicefs mount \
  --buffer-size 64 \
  --prefetch 1 \
  --max-uploads 4 \
  --get-timeout 15s \
  --put-timeout 15s \
  --writeback \
  --open-cache 5m \
  --cache-dir /cloud/cache/jfsCache \
  --cache-size 1024 \
  --upload-delay 40s \
  --free-space-ratio 0.05 \
  sqlite3:///cloud/cache/juicy_meta/juicy.db \
  /cloud/juicy
# 1. 先卸載掛載點
ExecStop=/bin/fusermount3 -u -z /cloud/juicy
 2. 稍作等待，確保檔案句柄釋放 (視情況，若不穩定可加這行)
ExecStop=/bin/sleep 1
 3. 執行最後一次 checkpoint 確保元數據完整寫回主資料庫
ExecStop=/usr/bin/sqlite3 /cloud/cache/juicy_meta/juicy.db "PRAGMA wal_checkpoint(TRUNCATE);"
#
ExecStop=/usr/bin/rm -f /cloud/cache/juicy_meta/.juicy_guard_state
[Install]
WantedBy=multi-user.target


