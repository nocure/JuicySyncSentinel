[Unit]
Description=JuiceFS Mount Primary Service (Juicy)
Requires=juicy-chunks-union.service
After=juicy-chunks-union.service
Wants=juicy-chunks-union.service juicy-disk-guard.timer juicy-upload.timer juicy-meta-backup.timer juicy-gc.timer

[Service]
Type=simple
#User=1001
#Group=1001
ExecStartPre=/usr/bin/mkdir -p /cloud/juicy
ExecStartPre=/usr/bin/sleep 1
ExecStart=/usr/local/bin/juicefs mount \
  --buffer-size 128 \
  --prefetch 1 \
  --max-uploads 4 \
  --writeback \
  --open-cache 5m \
  --cache-dir /cloud/cache/jfsCache \
  --cache-size 1024 \
  --upload-delay 40s \
  --free-space-ratio 0.05 \
  redis://127.0.0.1:6379/1 \
  /cloud/juicy

  
# 1. 先卸載掛載點
ExecStop=/bin/fusermount3 -u -z /cloud/juicy
# 2. 稍作等待，確保檔案句柄釋放 (視情況，若不穩定可加這行)
ExecStop=/bin/sleep 1
#
ExecStop=/usr/bin/rm -f /cloud/cache/juicy_meta/.juicy_guard_state
[Install]
WantedBy=multi-user.target


#  -o allow_other \
#  --cache-size 102400 #MB \
#  --open-cache-limit 10000 \
#  --upload-limit 72 #Mbps \
#  --free-space-ratio 0.05 #0.1=10% \
